Create a photo gallery using static files and EJS to display images dynamically.

<!DOCTYPE html>
<html>
<head><title>Photo Gallery</title></head>
<body>
  <h1>Photo Gallery</h1>
  <% images.forEach(img => { %>
    <div>
      <img src="/images/<%= img %>" alt="Photo" style="max-width: 300px;">
    </div>
  <% }) %>
</body>
</html>


Route addition in app.js:
// Photo gallery - add this route
app.get('/gallery', (req, res) => {
  res.render('gallery', { 
    images: ['photo1.jpg', 'photo2.jpg', 'photo3.jpg'] 
  });
});
