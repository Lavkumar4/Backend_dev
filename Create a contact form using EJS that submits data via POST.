const express = require('express');
const path = require('path');
const app = express();

// Middleware from previous steps
app.use(express.urlencoded({ extended: true }));
app.use(express.json());
app.use(express.static('public'));

// Response time middleware (from step 2)
const logResponseTime = (req, res, next) => {
  const start = process.hrtime();
  res.on('finish', () => {
    const elapsed = process.hrtime(start);
    const ms = elapsed[0] * 1000 + elapsed[1] * 1e-6;
    console.log(`${req.method} ${req.path} - ${ms.toFixed(3)}ms`);
  });
  next();
};
app.use(logResponseTime);

// User route from step 1
const users = [{ id: 1, name: 'John' }, { id: 2, name: 'Jane' }];
app.get('/users', (req, res) => {
  const { name } = req.query;
  let filtered = users;
  if (name) filtered = users.filter(u => u.name.toLowerCase().includes(name.toLowerCase()));
  res.json(filtered);
});

// EJS setup
app.set('view engine', 'ejs');
app.set('views', path.join(__dirname, 'views'));

// 3. Contact Form
app.get('/contact', (req, res) => res.render('contact'));
app.post('/contact', (req, res) => {
  const { name, email, message } = req.body;
  console.log('Contact form:', { name, email, message });
  res.render('contact', { success: true, data: req.body });
});

// 4. Custom 404
app.use((req, res) => res.status(404).render('404'));

// Blog data
const posts = [
  { id: 1, title: 'First Post', content: 'This is the first blog post.' },
  { id: 2, title: 'Second Post', content: 'This is the second blog post.' }
];

// 6. Blog Routes
app.get('/blog', (req, res) => res.render('blog/index', { posts }));
app.get('/blog/new', (req, res) => res.render('blog/new'));
app.get('/blog/:id', (req, res) => {
  const post = posts.find(p => p.id == req.params.id);
  if (!post) return res.status(404).render('404');
  res.render('blog/show', { post });
});
app.post('/blog', (req, res) => {
  const { title, content } = req.body;
  const newPost = { id: posts.length + 1, title, content };
  posts.push(newPost);
  res.redirect('/blog');
});

app.listen(3000, () => console.log('Server on port 3000'));
